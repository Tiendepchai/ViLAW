# Common
PYTHONUNBUFFERED=1
TZ=Asia/Ho_Chi_Minh

# Corpus source (ZIP chính thức)
BOPD_ZIP_URL=https://phapdien.moj.gov.vn/TraCuuPhapDien/Files/BoPhapDienDienTu.zip

# Paths inside containers (mapped to volumes)
DATA_DIR=/app/data
INDEX_DIR=/app/indexes

# Embedding backend:
#  - builtin    : HashingVectorizer + Tfidf fallback (nhẹ, không cần model nặng)
#  - st         : sentence-transformers (nếu bạn cài thêm)
EMBEDDER_BACKEND=builtin
EMBEDDER_MODEL=intfloat/multilingual-e5-small   # dùng khi EMBEDDER_BACKEND=st

# Hybrid weights (fallback, còn được điều chỉnh động theo query)
DEFAULT_ALPHA=0.6
DEFAULT_BETA=0.4

# RQ / Redis
REDIS_HOST=redis
REDIS_PORT=6379
RQ_QUEUE=bo_pd_jobs

# Updater (cron-like, HH:MM hàng ngày)
DAILY_REFRESH_AT=03:30

