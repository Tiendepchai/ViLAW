# ======== Chung ========
PYTHONUNBUFFERED=1
TZ=Asia/Ho_Chi_Minh

# ======== Nguồn dữ liệu Bộ Pháp điển ========
BOPD_ZIP_URL=https://phapdien.moj.gov.vn/TraCuuPhapDien/Files/BoPhapDienDienTu.zip

# ======== Thư mục ========
DATA_DIR=/app/data
INDEX_DIR=/app/indexes

# ======== Embedding ========
EMBEDDER_BACKEND=builtin    # builtin | st
EMBEDDER_MODEL=intfloat/multilingual-e5-small

# ======== Hybrid search ========
DEFAULT_ALPHA=0.6
DEFAULT_BETA=0.4

# ======== Redis / Queue ========
REDIS_HOST=redis
REDIS_PORT=6379
RQ_QUEUE=bo_pd_jobs

# ======== Updater ========
MONTHLY_DAYS=1,16
DAILY_REFRESH_AT=03:30

# ======== LLM backend ========
# --- Cách A: Dùng Ollama local (mặc định) ---
RAG_BACKEND=ollama
RAG_MODEL=qwen2.5:7b
OLLAMA_HOST=http://ollama:11434

# --- Cách B: Dùng OpenAI-compatible remote API ---
# Chỉ cần set 2 biến này, Ollama sẽ bị skip hoàn toàn.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ======== Auth (optional) ========
AUTH_ENABLED=false
AUTH_SECRET=change-me-in-production

# ======== Metrics (optional) ========
ENABLE_METRICS=false
